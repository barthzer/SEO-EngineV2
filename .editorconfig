# Cohérence d'édition front ↔ back — évite le bruit de diff (fins de ligne, indentation).
# Pas de reformatage automatique : juste des défauts d'éditeur partagés.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
